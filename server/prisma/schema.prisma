generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model City {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  townships Township[]
}

model Township {
  id     Int    @id @default(autoincrement())
  name   String
  cityId Int

  city City @relation(fields: [cityId], references: [id])
  drivers Driver[]
  @@unique([name, cityId])
}

enum DriverStatus {
  ACTIVE
  BUSY
}

model Driver {
  id           Int          @id @default(autoincrement())
  name         String
  email        String       @unique
  phone        String
  vehicleNo    String       @unique
  password     String
  status       DriverStatus @default(ACTIVE)
  townshipId   Int
  createdAt    DateTime     @default(now())

  township     Township     @relation(fields: [townshipId], references: [id])
  gpsLocations GPSLocation[]
}

model GPSLocation {
  id         Int      @id @default(autoincrement())
  driverId   Int
  latitude   Float
  longitude  Float
  recordedAt DateTime @default(now())

  driver Driver @relation(fields: [driverId], references: [id])

  @@index([driverId, recordedAt])
}
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model City {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  townships Township[]
}

model Township {
  id     Int    @id @default(autoincrement())
  name   String
  cityId Int

  city City @relation(fields: [cityId], references: [id])

  @@unique([name, cityId])
}